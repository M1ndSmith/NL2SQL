# Privilege, models, limits, and prices live in config.yaml.
# A value set here overrides the same setting in that file.
# Everything below is a secret, a service URL, or a value for one run.

# One or more providers. Only credentials that are set are used.
# Fallback order: openai, groq, nvidia, ollama.
# LLM_PROVIDER=

OPENAI_API_KEY=
OPENAI_BASE_URL=

GROQ_API_KEY=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama has no real key. Set the base URL to enable it.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama

# Required. Budget and rate limits use this Redis.
REDIS_URL=redis://localhost:6379/0
# Optional overlay on the prices in config.yaml:
# {"model-name": [input_usd_per_1m, output_usd_per_1m]}
LLM_PRICES_JSON=

# Optional semantic cache for cheap read answers.
LANGCACHE_SERVER_URL=
LANGCACHE_API_KEY=
LANGCACHE_CACHE_ID=

# Optional. Missing keys keep the in-code prompts and skip traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional long-term memory. Separate from the SQL database roles and from checkpoints.
NL2SQL_MEMORY_DSN=postgresql://nl2sql_memory:pw@localhost:5432/memory

# Required. Short-term thread state so an approval can resume. Separate database from mem0 and from the SQL roles.
NL2SQL_CHECKPOINT_DSN=postgresql://nl2sql_checkpoint:pw@localhost:5432/checkpoints
# Optional. Set this, or pass a third argument, to resume that thread from the local CLI.
NL2SQL_THREAD_ID=

# Auth database. Demo users in docker init: ada/ada (analyst), grace/grace (ops).
NL2SQL_AUTH_DSN=postgresql://nl2sql_auth:pw@localhost:5432/auth
NL2SQL_PASSWORD=

# One database login per role. The sandbox never falls back to a shared writer.
NL2SQL_ANALYST_DSN=postgresql://nl2sql_analyst:pw@localhost:5432/app
NL2SQL_OPS_DSN=postgresql://nl2sql_ops:pw@localhost:5432/app

# Append-only log of executed SQL. The analyst and ops logins cannot write this database.
NL2SQL_AUDIT_DSN=postgresql://nl2sql_audit:pw@localhost:5432/audit
